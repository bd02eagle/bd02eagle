<new_str>enum Role {
  ADMIN
  ANALYST
  CHARTER
}

enum AnalystDecision {
  APPROVE
  REQUEST_CHANGES
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  profilePicture String? // URL to profile image
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags           Tag[]           @relation("TagCreatedBy")
  analystActions AnalystAction[]
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  shortName String? // e.g., "LAL" for Lakers
  logo      String? // URL to team logo
  primaryColor String? // hex color
  secondaryColor String? // hex color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")
}

model Game {
  id        String     @id @default(uuid())
  date      DateTime
  homeTeamId String
  awayTeamId String
  homeTeam  Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  status    GameStatus @default(SCHEDULED)
  homeScore Int?
  awayScore Int?
  venue     String?
  season    String? // e.g., "2024-25"
  gameType  String? // e.g., "Regular Season", "Playoffs"
  thumbnail String? // URL to game thumbnail/preview image
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events Event[]
}</old_str>
