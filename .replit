[[workflows.workflow]]
name = "Fixed Full Stack"
author = 44371205
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run seed"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start &"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Backend started on port 3000, now starting frontend...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm start"

