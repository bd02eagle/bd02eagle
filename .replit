[[workflows.workflow]]
name = "Start Full Stack Debug"
author = 44371205
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run seed"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Starting backend server...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start &"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 5"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Backend should be running on port 3000\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Starting frontend server...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm start"

[[workflows.workflow]]
name = "Start Full Stack Fixed"
author = 44371205
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run seed"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start &"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Backend started, now starting frontend...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && node server.js"

